{
    "model": "aria-home-direct/llm-coding",
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aria-home": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aria (GW)",
            "options": {
                "baseURL": "https://ai.stronghold/gw/v1",
                "apiKey": "{env:ARIA_API_GW_KEY}",
                "headers": {
                    "X-Tool-Name": "opencode"
                }
            },
            "models": {
                "llm-coding": {
                    "name": "llm-coding-gw",
                    "limit": {
                        "context": 250000,
                        "output": 128000
                    }
                },
                "llm-research": {
                    "name": "llm-research-gw",
                    "limit": {
                        "context": 250000,
                        "output": 128000
                    }
                },
                "accounts/fireworks/routers/kimi-k2p6-turbo": {
                    "name": "llm-firepass",
                    "limit": {
                        "context": 256000,
                        "output": 128000
                    }
                },
                "glm-5.1": {
                    "name": "llm-glm-5.1",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-5-turbo": {
                    "name": "llm-glm-5-turbo",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-5v-turbo": {
                    "name": "llm-glm-5v-turbo",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-4.7": {
                    "name": "llm-glm-4.7",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-4.7-flash": {
                    "name": "llm-glm-4.7-flash",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-4.7-flashx": {
                    "name": "llm-glm-4.7-flashx",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
                "glm-4.6v": {
                    "name": "llm-glm-4.7",
                    "limit": {
                        "context": 200000,
                        "output": 128000
                    }
                },
            }
        },
        "aria-home-direct": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aria Home (Direct)",
            "options": {
                "baseURL": "http://ai:8000/v1",
                "headers": {
                    "X-Tool-Name": "opencode"
                }
            },
            "models": {
                "llm-coding": {
                    "name": "llm-coding-direct",
                    "limit": {
                        "context": 143360,
                        "output": 65536
                    }
                },
                "llm-research": {
                    "name": "llm-research-direct",
                    "limit": {
                        "context": 128000,
                        "output": 32768
                    }
                }
            }
        },
    },
    "mcp": {
	"ariahome": {
	  "type": "remote",
	  "url": "http://localhost:12344/mcp",
	  "enabled": true,
            "headers": {
                "Authorization": "Bearer ARIA_{env:ARIA_HOME_MCP_KEY}"
            }
	},
        "penpot": {
            "type": "remote",
            "url": "http://localhost:4401/mcp",
            "enabled": true,
            "timeout": 120000
        }
    }
}
