  },
  "mcp": {
    "ariahome": {
      "type": "remote",
      "url": "http://localhost:12344/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ARIA_{env:ARIA_HOME_MCP_KEY}"
      }
    },
    "pencil": {
      "type": "remote",
      "url": "http://pencil.stronghold:3101/mcp",
      "enabled": true,
      "timeout": 120000
    }
  }
