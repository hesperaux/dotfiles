    "aria-home-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aria Home (Direct)",
      "options": {
        "baseURL": "http://ai:8000/v1",
        "headers": {
          "X-Tool-Name": "opencode"
        }
      },
      "models": {
        "llm-coding": {
          "name": "llm-coding-direct",
          "limit": {
            "context": 158720,
            "output": 65536
